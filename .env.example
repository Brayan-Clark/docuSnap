# ---------------------------------------------------------------------------
# DocuSnap AI — Variables d'environnement
# ---------------------------------------------------------------------------
# L'application fonctionne SANS aucune clé : le moteur OCR local gratuit
# (Tesseract.js) est utilisé par défaut. Gemini est un bonus de précision.

# GEMINI_API_KEY: optionnel — active le moteur Gemini Vision (meilleure
# précision sur les photos réelles). Clé gratuite via Google AI Studio :
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# GEMINI_MODEL: optionnel — force un modèle Gemini précis.
# Par défaut, chaîne de repli : gemini-3.6-flash → gemini-3-flash →
# gemini-2.5-flash → gemini-2.0-flash
GEMINI_MODEL=""

# OPENROUTER_API_KEY: optionnel — active l'IA gratuite via OpenRouter
# (inscription gratuite, zéro CB, ~95% précision). Inscription :
# https://openrouter.ai/keys
# Modèles gratuits supportés : nvidia/nemotron-nano-12b-v2-vl:free (vision)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# JWT_SECRET: obligatoire en production pour signer les tokens d'auth.
JWT_SECRET=""

# PORT: optionnel — port du serveur (défaut 3000)
PORT="3000"

# APP_URL: URL publique où l'app est hébergée (utilisée pour les liens
# d'auto-référence et callbacks). Optionnel en local.
APP_URL=""
